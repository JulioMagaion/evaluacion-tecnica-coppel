<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>
        <!-- Configuración para imprimir en consola -->
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n"/>
        </Console>
    </Appenders>

    <Loggers>
        <!-- Nivel global de la aplicación (INFO para no saturar) -->
        <Root level="info">
            <AppenderRef ref="Console"/>
        </Root>

        <!-- Nivel específico para paquetes (DEBUG para ver los propios detalles) -->
        <Logger name="com.pinwox.tvmaze" level="debug" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>
    </Loggers>
</Configuration>